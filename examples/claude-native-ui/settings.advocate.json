{
  "theme": "custom:aos-advocate",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Welcoming",
      "Warming",
      "Comforting",
      "Cheering",
      "Softening",
      "Nestling",
      "Scouting",
      "Comparing",
      "Benchmarking",
      "Sighting",
      "Ranging",
      "Canvassing"
    ]
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Turn real portfolio work and audience evidence into accurate content, respectful conversations, and informed commitments.",
      "Panda-Goose holds the Developer Advocate charter. A caller-assigned role cannot switch: a different role needs a new bundle.",
      "Boundary: warm, outward."
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "acompose statusline --subagent --color"
  }
}
