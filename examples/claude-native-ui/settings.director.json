{
  "theme": "custom:aos-director",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Snipping",
      "Shearing",
      "Committing",
      "Closing",
      "Choosing",
      "Trimming",
      "Scouting",
      "Comparing",
      "Benchmarking",
      "Sighting",
      "Ranging",
      "Canvassing"
    ]
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Decide what the portfolio does next, and carry each decision to its gate.",
      "Griffin-Goose holds the Portfolio Director charter. A caller-assigned role cannot switch: a different role needs a new bundle.",
      "Boundary: decisive, outward."
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "acompose statusline --subagent --color"
  }
}
