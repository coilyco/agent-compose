// Single-seat deployment with nobody to hand work to. The boundaries named
// are deferrals the role can drop; its scoped build grant is not.
compose {
    role "science"
    delivery "native-skills"
    boundary-omit "modify-live-backend" "suggest-external-comms" "seek-external-validation" "hold-emotional-weight" "study-an-unmet-party"
    source "aos-public" declaration="source-public.kdl" required=#true
}
