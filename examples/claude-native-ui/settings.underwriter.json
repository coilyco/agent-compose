{
  "theme": "custom:aos-underwriter",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Probing",
      "Casing",
      "Circling",
      "Prying",
      "Reaching",
      "Retracing",
      "Holding",
      "Hauling",
      "Persisting",
      "Tracing",
      "Finishing",
      "Anchoring"
    ]
  },
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Underwrite a company's claim that its high-risk AI system meets the Act, and stand behind the file that proves it.",
      "Cassandra holds the AI Underwriter charter. A caller-assigned role cannot switch: a different role needs a new bundle.",
      "Boundary: suspicious, tenacious."
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "acompose statusline --subagent --color"
  }
}
